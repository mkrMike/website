---
/** Floating corner button that opens a WhatsApp conversation with the team. */
import { site } from '../config/site'
import { type Locale, useTranslations } from '../i18n'

interface Props {
  lang: Locale
}

const { lang } = Astro.props
const t = useTranslations(lang)
---

<a
  class="whatsapp"
  href={`https://wa.me/${site.whatsappPhone}`}
  target="_blank"
  rel="noopener"
  title={t.common.whatsapp}
  aria-label={t.common.whatsapp}
>
  <svg viewBox="0 0 32 32" width="30" height="30" fill="currentColor" aria-hidden="true">
    <path
      d="M16 3C9.1 3 3.5 8.6 3.5 15.5c0 2.2.6 4.3 1.6 6.2L3.4 28.6l7.1-1.9c1.8 1 3.8 1.5 5.9 1.5h.1c6.9 0 12.5-5.6 12.5-12.5S22.9 3 16 3zm0 22.9c-1.9 0-3.7-.5-5.3-1.4l-.4-.2-4.2 1.1 1.1-4.1-.2-.4c-1-1.6-1.5-3.5-1.5-5.4C5.5 9.7 10.2 5 16 5s10.5 4.7 10.5 10.5S21.8 25.9 16 25.9zm5.8-7.8c-.3-.2-1.9-.9-2.2-1-.3-.1-.5-.2-.7.2-.2.3-.8 1-1 1.2-.2.2-.4.2-.7.1-.3-.2-1.3-.5-2.5-1.6-.9-.8-1.6-1.9-1.8-2.2-.2-.3 0-.5.1-.6l.5-.6c.2-.2.2-.3.3-.5.1-.2.1-.4 0-.6-.1-.2-.7-1.7-1-2.3-.3-.6-.5-.5-.7-.5h-.6c-.2 0-.6.1-.9.4-.3.3-1.1 1.1-1.1 2.7s1.1 3.1 1.3 3.3c.2.2 2.2 3.4 5.4 4.8.8.3 1.3.5 1.8.7.8.2 1.5.2 2 .1.6-.1 1.9-.8 2.1-1.5.3-.7.3-1.4.2-1.5-.1-.2-.3-.2-.6-.4z"
    ></path>
  </svg>
</a>

<style>
  .whatsapp {
    position: fixed;
    bottom: clamp(1rem, 3vw, 1.75rem);
    inset-inline-end: clamp(1rem, 3vw, 1.75rem);
    z-index: 45;
    display: grid;
    place-items: center;
    width: 58px;
    height: 58px;
    border-radius: 50%;
    background: #25d366;
    color: #fff;
    box-shadow: var(--shadow-lg);
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }

  .whatsapp:hover {
    transform: scale(1.08);
    box-shadow: 0 12px 32px rgb(37 211 102 / 0.45);
  }
</style>
