---
import SimplePage from '../../components/SimplePage.astro'
import { type Locale, localePaths, useTranslations } from '../../i18n'

export const getStaticPaths = localePaths

const lang = Astro.params.lang as Locale
const t = useTranslations(lang)
---

<!-- Draft until a lawyer writes the real text before launch: no legal promises here, and noindex. -->
<SimplePage lang={lang} page="terms" title={t.legal.termsTitle} metaTitle={t.meta.termsTitle} noindex>
  <p class="draft"><span>{t.legal.draft}</span>{t.legal.placeholder}</p>
</SimplePage>

<style>
  .draft {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem;
    padding: 1.25rem 1.5rem;
    border: 1px dashed var(--line);
    border-radius: var(--radius-sm);
    background: var(--surface);
  }

  .draft span {
    padding: 0.2rem 0.65rem;
    border-radius: 999px;
    background: #fff4d6;
    color: #8a6100;
    font-size: 0.8rem;
    font-weight: 700;
  }
</style>
