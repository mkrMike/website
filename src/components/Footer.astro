---
import { href, type Locale, type PagePath, useTranslations } from '../i18n'
import Logo from './brand/Logo.astro'
import LanguageSwitcher from './LanguageSwitcher.astro'

interface Props {
  lang: Locale
  page: PagePath
}

const { lang, page } = Astro.props
const t = useTranslations(lang)
const year = new Date().getFullYear()
---

<footer class="site-footer">
  <div class="container">
    <div class="top">
      <div class="about">
        <Logo tone="white" arc="same" height={22} />
        <p>{t.footer.tagline}</p>
      </div>

      <nav class="cols" aria-label="Footer">
        <div>
          <h2>{t.footer.product}</h2>
          <ul>
            <li><a href={href(lang, 'contact')}>{t.nav.startTrial}</a></li>
          </ul>
        </div>
        <div>
          <h2>{t.footer.company}</h2>
          <ul>
            <li><a href={href(lang, 'contact')}>{t.nav.contact}</a></li>
          </ul>
        </div>
        <div>
          <h2>{t.footer.legal}</h2>
          <ul>
            <li><a href={href(lang, 'terms')}>{t.legal.termsTitle}</a></li>
            <li><a href={href(lang, 'privacy')}>{t.legal.privacyTitle}</a></li>
            <li><a href={href(lang, 'refund')}>{t.legal.refundTitle}</a></li>
          </ul>
        </div>
      </nav>
    </div>

    <div class="bottom">
      <p>© {year} Samatrica. {t.footer.rights}</p>
      <LanguageSwitcher lang={lang} page={page} up dark />
    </div>
  </div>
</footer>

<style>
  .site-footer {
    padding-block: 4rem 2rem;
    background: #081b33;
    color: #94a3b8;
    font-size: 0.95rem;
  }

  .top {
    display: grid;
    gap: 2.5rem;
  }

  @media (min-width: 860px) {
    .top {
      grid-template-columns: 1.2fr 2fr;
    }
  }

  .about p {
    max-width: 340px;
    margin-top: 1rem;
  }

  .cols {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
    gap: 2rem;
  }

  h2 {
    margin-bottom: 0.9rem;
    color: #fff;
    font-size: 0.9rem;
    letter-spacing: 0.02em;
  }

  ul {
    display: grid;
    gap: 0.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  a {
    color: #cbd5e1;
    text-decoration: none;
  }

  a:hover {
    color: #fff;
  }

  .bottom {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-top: 3rem;
    padding-top: 1.5rem;
    border-top: 1px solid rgb(255 255 255 / 0.08);
  }

  .bottom p {
    margin: 0;
  }
</style>
