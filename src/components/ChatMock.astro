---
/**
 * A chat widget conversation that books an appointment: the hero visual.
 * Pure HTML/CSS; messages appear one by one (instantly with reduced motion).
 */
import { type Locale, useTranslations } from '../i18n'
import Mark from './brand/Mark.astro'
import Icon from './Icon.astro'

interface Props {
  lang: Locale
}

const { lang } = Astro.props
const t = useTranslations(lang)
const c = t.chat.clinic

const messages = [
  { from: 'customer', text: c.customer1 },
  { from: 'assistant', text: c.assistant1 },
  { from: 'customer', text: c.customer2 },
  { from: 'assistant', text: c.assistant2 },
] as const
---

<figure class="chat" aria-label={t.chat.title}>
  <div class="chat-head">
    <span class="avatar"><Mark tone="white" size={30} /></span>
    <div>
      <strong>{t.chat.title}</strong>
      <span class="status"><span class="dot"></span>{t.chat.status}</span>
    </div>
  </div>

  <ol class="chat-body">
    {
      messages.map((message, index) => (
        <li class:list={['msg', message.from]} style={`--i: ${index}`}>
          {message.text}
        </li>
      ))
    }
    <li class="status-chip sent" style="--i: 4">
      <Icon name="clock" size={18} />
      {c.booked}
    </li>
    <li class="status-chip confirmed" style="--i: 5">
      <Icon name="check" size={18} />
      {c.confirmed}
    </li>
  </ol>

  <div class="chat-input" aria-hidden="true">
    <span>{t.chat.placeholder}</span>
    <span class="send"><Icon name="send" size={16} /></span>
  </div>
</figure>

<style>
  .chat {
    position: relative;
    width: 100%;
    max-width: 400px;
    margin: 0;
    border: 1px solid rgb(255 255 255 / 0.7);
    border-radius: 26px;
    background: rgb(255 255 255 / 0.92);
    box-shadow:
      0 30px 80px rgb(11 37 69 / 0.16),
      0 2px 8px rgb(15 23 42 / 0.06);
    overflow: hidden;
    backdrop-filter: blur(10px);
  }

  .chat-head {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 1rem 1.15rem;
    background: var(--brand);
    color: #fff;
  }

  .chat-head strong {
    display: block;
    font-size: 0.98rem;
  }

  .avatar {
    display: grid;
    place-items: center;
    width: 38px;
    height: 38px;
    border-radius: 50%;
    background: none;
  }

  .status {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.8rem;
    opacity: 0.92;
  }

  .dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: #86efac;
    box-shadow: 0 0 0 3px rgb(134 239 172 / 0.3);
  }

  .chat-body {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    margin: 0;
    padding: 1.15rem;
    list-style: none;
    min-height: 330px;
  }

  .msg {
    max-width: 84%;
    padding: 0.65rem 0.9rem;
    border-radius: 18px;
    font-size: 0.93rem;
    line-height: 1.45;
    animation: pop 0.5s cubic-bezier(0.2, 0.8, 0.2, 1) both;
    animation-delay: calc(0.5s + var(--i) * 1.1s);
  }

  .customer {
    align-self: flex-end;
    border-end-end-radius: 6px;
    background: var(--brand);
    color: #fff;
  }

  .assistant {
    align-self: flex-start;
    border-end-start-radius: 6px;
    background: #f1f5f9;
    color: var(--ink);
  }

  /* The request is sent, then the business confirms it. */
  .status-chip {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    align-self: center;
    padding: 0.5rem 0.9rem;
    border-radius: 999px;
    font-size: 0.85rem;
    font-weight: 650;
    animation: pop 0.6s cubic-bezier(0.2, 0.8, 0.2, 1) both;
    animation-delay: calc(0.5s + var(--i) * 1.1s);
  }

  .sent {
    margin-top: 0.35rem;
    border: 1px solid #99f6e4;
    background: #f0fdfa;
    color: var(--teal-dark);
  }

  .confirmed {
    border: 1px solid #bbf7d0;
    background: #f0fdf4;
    color: #15803d;
  }

  .chat-input {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin: 0 1rem 1rem;
    padding-block: 0.55rem;
    padding-inline: 1rem 0.55rem;
    border: 1px solid var(--line);
    border-radius: 999px;
    color: var(--muted);
    font-size: 0.9rem;
  }

  .send {
    display: grid;
    place-items: center;
    width: 32px;
    height: 32px;
    border-radius: 50%;
    background: var(--coral);
    color: #fff;
  }

  :global([dir='rtl']) .send :global(svg) {
    transform: scaleX(-1);
  }

  @keyframes pop {
    from {
      opacity: 0;
      transform: translateY(10px) scale(0.97);
    }

    to {
      opacity: 1;
      transform: none;
    }
  }
</style>
