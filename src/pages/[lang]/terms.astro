---
import SimplePage from '../../components/SimplePage.astro'
import { type Locale, localePaths, useTranslations } from '../../i18n'

export const getStaticPaths = localePaths

const lang = Astro.params.lang as Locale
const t = useTranslations(lang)
---

<SimplePage lang={lang} page="terms" title={t.legal.termsTitle} metaTitle={t.meta.termsTitle}>
  <p class="updated">{t.legal.updated}</p>
  {
    t.legal.terms.map((section) => (
      <section class="legal-section">
        <h2>{section.title}</h2>
        {section.paragraphs.map((paragraph) => (
          <p>{paragraph}</p>
        ))}
      </section>
    ))
  }
</SimplePage>

<style>
  .updated {
    color: var(--muted);
    font-size: 0.9rem;
  }

  .legal-section h2 {
    margin-top: 2rem;
    font-size: 1.25rem;
  }

  .legal-section p {
    color: var(--text);
  }
</style>
