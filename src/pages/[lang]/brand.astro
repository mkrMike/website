---
/** Internal: the logo and its variants. Not linked, not indexed. */
import Logo from '../../components/brand/Logo.astro'
import Mark from '../../components/brand/Mark.astro'
import Base from '../../layouts/Base.astro'
import { type Locale, localePaths, useTranslations } from '../../i18n'

export const getStaticPaths = localePaths

const lang = Astro.params.lang as Locale
const t = useTranslations(lang)
const b = t.brand
const iconSizes = [96, 64, 48, 32, 24, 16]
---

<Base lang={lang} page="brand" title={t.meta.brandTitle} noindex>
  <section class="page-hero">
    <div class="container">
      <h1>{b.title}</h1>
      <p>{b.subtitle}</p>
    </div>
  </section>

  <section class="section">
    <div class="container sheet">
      <h2>{b.main}</h2>
      <div class="row two">
        <figure class="tile">
          <Logo height={64} />
          <figcaption>{b.tealArc}</figcaption>
        </figure>
        <figure class="tile">
          <Logo height={64} arc="same" />
          <figcaption>{b.navyArc}</figcaption>
        </figure>
      </div>

      <div class="row three">
        <figure class="tile tile-navy">
          <Logo height={44} tone="white" arc="same" />
          <figcaption>{b.reversed}</figcaption>
        </figure>
        <figure class="tile">
          <Logo height={44} arc="same" />
          <figcaption>{b.oneColorNavy}</figcaption>
        </figure>
        <figure class="tile">
          <Logo height={44} tone="black" arc="same" />
          <figcaption>{b.oneColorBlack}</figcaption>
        </figure>
      </div>

      <h2>{b.horizontal}</h2>
      <div class="row two">
        <figure class="tile">
          <Logo layout="horizontal" height={36} />
          <figcaption>{b.horizontal}</figcaption>
        </figure>
        <figure class="tile tile-navy">
          <Logo layout="horizontal" height={36} tone="white" arc="same" />
          <figcaption>{b.horizontal} · {b.reversed}</figcaption>
        </figure>
      </div>

      <h2>{b.icon}</h2>
      <div class="row three">
        {
          (['navy', 'white', 'black'] as const).map((tone) => (
            <figure class:list={['tile', { 'tile-navy': tone === 'white' }]}>
              <div class="icons">
                {iconSizes.map((size) => (
                  <Mark tone={tone} size={size} />
                ))}
              </div>
              <figcaption>{tone === 'navy' ? b.main : tone === 'white' ? b.reversed : b.oneColorBlack}</figcaption>
            </figure>
          ))
        }
      </div>
      <p class="note">{b.iconSizes}</p>
    </div>
  </section>
</Base>

<style>
  .sheet h2 {
    margin-top: 3rem;
    font-size: 1.3rem;
  }

  .sheet h2:first-child {
    margin-top: 0;
  }

  .row {
    display: grid;
    gap: 1rem;
    margin-top: 1rem;
  }

  @media (min-width: 900px) {
    .row.two {
      grid-template-columns: repeat(2, 1fr);
    }

    .row.three {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .tile {
    display: grid;
    gap: 1.5rem;
    justify-items: start;
    margin: 0;
    padding: 2.5rem 2rem 1.5rem;
    border: 1px solid var(--line);
    border-radius: 20px;
    background: #fff;
  }

  .tile-navy {
    border-color: transparent;
    background: var(--navy);
    color: #fff;
  }

  .icons {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    gap: 1rem;
  }

  figcaption {
    font-size: 0.85rem;
    font-weight: 600;
    opacity: 0.75;
  }

  .note {
    margin-top: 1rem;
    color: var(--muted);
    font-size: 0.92rem;
  }
</style>
