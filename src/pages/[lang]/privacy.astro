---
import SimplePage from '../../components/SimplePage.astro'
import { type Locale, localePaths, useTranslations } from '../../i18n'

export const getStaticPaths = localePaths

const lang = Astro.params.lang as Locale
const t = useTranslations(lang)
---

<!-- Draft until a lawyer approves the text: marked as such, and noindex. -->
<SimplePage lang={lang} page="privacy" title={t.legal.privacyTitle} metaTitle={t.meta.privacyTitle} noindex>
  <p class="draft"><span>{t.legal.draft}</span>{t.legal.draftNote}</p>
  <p class="updated">{t.legal.updated}</p>
  {
    t.legal.privacy.map((section) => (
      <section class="legal-section">
        <h2>{section.title}</h2>
        {section.paragraphs.map((paragraph) => (
          <p>{paragraph}</p>
        ))}
      </section>
    ))
  }
</SimplePage>

<style>
  .draft {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem;
    padding: 1.25rem 1.5rem;
    border: 1px dashed var(--line);
    border-radius: var(--radius-sm);
    background: var(--surface);
  }

  .draft span {
    padding: 0.2rem 0.65rem;
    border-radius: 999px;
    background: #fff4d6;
    color: #8a6100;
    font-size: 0.8rem;
    font-weight: 700;
  }

  .updated {
    color: var(--muted);
    font-size: 0.9rem;
  }

  .legal-section h2 {
    margin-top: 2rem;
    font-size: 1.25rem;
  }

  .legal-section p {
    color: var(--text);
  }
</style>
